<?xml version="1.0" ?>
<sdf version="1.9">

<world name="sancak_world">

  <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

  <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

  <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
  </light>

  <include>
    <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
  </include>

  <!-- KIRMIZI PAD -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/red_pad</uri>
    <pose>18.0 5.0 0.02 0 0 0</pose>
  </include>

  <!-- MAVI PAD -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/blue_pad</uri>
    <pose>18.0 13.0 0.02 0 0 0</pose>
  </include>

  <!-- QR 1 -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/qr_plaka_1</uri>
    <pose>25.0 9.0 0.02 0 0 0</pose>
  </include>

  <!-- QR 2 -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/qr_plaka_2</uri>
    <pose>25.0 17.66 0.02 0 0 0</pose>
  </include>

  <!-- QR 3 -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/qr_plaka_3</uri>
    <pose>15.0 0.66 0.02 0 0 0</pose>
  </include>

  <!-- QR 4 -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/qr_plaka_4</uri>
    <pose>10.0 9.0 0.02 0 0 0</pose>
  </include>

  <!-- QR 5 -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/qr_plaka_5</uri>
    <pose>15.0 17.66 0.02 0 0 0</pose>
  </include>

  <!-- QR 6 -->
  <include>
    <uri>file:///home/tunahan/sancak_ws/models/qr_plaka_6</uri>
    <pose>25.0 0.66 0.02 0 0 0</pose>
  </include>

  <!-- DRONE 1 -->
  <include>
    <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/4</uri>
    <name>drone1</name>
    <pose>0 0 0.3 0 0 0</pose>
  </include>

  <!-- DRONE 2 -->
  <include>
    <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/4</uri>
    <name>drone2</name>
    <pose>0 2 0.3 0 0 0</pose>
  </include>

  <!-- DRONE 3 -->
  <include>
    <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/4</uri>
    <name>drone3</name>
    <pose>0 -2 0.3 0 0 0</pose>
  </include>

</world>

</sdf>
